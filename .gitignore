# Dotfiles and dot-folders (.env*, .venv/, .secrets/, .codex/, .agents/, ...)
.*
!.gitignore

# App data and runtime state
*.ics
data/
feeds.json
alerts-state.json
alerts-fired.json

# Build output
dist/
build/
*.zip

# Dependencies and Python caches
node_modules/
venv/
__pycache__/
*.py[cod]

# Secrets and logs
secrets/
*.pem
*.key
*.log
