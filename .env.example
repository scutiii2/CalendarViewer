# Copy to .env (git-ignored) and fill in. tools/deploy.bat option 2 sends .env to the server.

# Host port for the web page.
CALENDAR_PORT=3000

# Where the page is published. 127.0.0.1 = this server only (reach it through an ssh tunnel).
# 0.0.0.0 = your whole network, so ZimaOS can open it as an app link. The page has no sign-in:
# anyone on the network can read the calendars, so use it only on a network you trust.
CALENDAR_BIND_HOST=127.0.0.1

# Optional local calendar assistant (off by default). Process environment only.
CALENDAR_ASSISTANT_ENABLED=0
MINICPM_URL=http://127.0.0.1:9130
# Optional credential: inject MINICPM_TOKEN into the process environment; never store it in data/.
# MINICPM_TOKEN=

